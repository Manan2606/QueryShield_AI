# App
APP_ENV=local
DATABASE_URL=sqlite:///./queryshield.db

# Auth
JWT_SECRET_KEY=change_me_for_local_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
BIGQUERY_DATASET_ID=queryshield_demo

# Local only credential file
# Do not use this on Cloud Run
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Query controls
MAX_BYTES_BILLED=100000000
QUERY_RESULT_ROW_LIMIT=100
QUERY_TIMEOUT_SECONDS=30
BIGQUERY_ON_DEMAND_PRICE_PER_TIB=6.25
BIGQUERY_CURRENCY=USD

# Storage
# local = save uploaded CSVs on local disk
# gcs = save uploaded CSVs to Cloud Storage
STORAGE_BACKEND=local
GCS_UPLOAD_BUCKET=
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=20
CSV_PREVIEW_ROWS=10