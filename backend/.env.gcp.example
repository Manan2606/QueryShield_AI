# App
APP_ENV=production
DATABASE_URL=sqlite:////tmp/queryshield.db

# Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
FRONTEND_ORIGINS=https://YOUR_FRONTEND_CLOUD_RUN_URL

# GCP
GCP_PROJECT_ID=queryshield-501723
GCP_REGION=us-central1
BIGQUERY_DATASET_ID=queryshield_demo

# Do not use GOOGLE_APPLICATION_CREDENTIALS on Cloud Run.
# Cloud Run should use queryshield-backend-sa runtime identity.

# Gemini
GEMINI_MODEL=gemini-2.5-flash

# Query controls
MAX_BYTES_BILLED=100000000
QUERY_RESULT_ROW_LIMIT=100
QUERY_TIMEOUT_SECONDS=30
BIGQUERY_ON_DEMAND_PRICE_PER_TIB=6.25
BIGQUERY_CURRENCY=USD

# Storage
STORAGE_BACKEND=gcs
GCS_UPLOAD_BUCKET=queryshield_ai
UPLOAD_DIR=/tmp/uploads
MAX_UPLOAD_SIZE_MB=20
CSV_PREVIEW_ROWS=10

# AI result summaries
AI_SUMMARY_ENABLED=true
SUMMARY_MAX_ROWS=25
SUMMARY_MAX_CHARS=6000
